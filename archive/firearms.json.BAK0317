    "cartridgeImage": "308-Win-150-gr--InterLock-SP-American-Whitetail.jpg",
    "cartridgeWiki": "https://en.wikipedia.org/wiki/.308_Winchester",
    "caliber": ".308",
    "feed": "Box Magazine",
    "magCapacity": 99,
