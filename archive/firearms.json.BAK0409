  {
    "type": "Shotgun",
    "make": "Remington",
    "model": "Model 10",
    "year": null,
    "cartridge": "add Cart-Name",
    "COAL": "add Cart-Name",
    "cartridgeImage": "dummy.jpg",
    "cartridgeWiki": "add Cart-Name",
