images/
# ...except the shared reference art (not per-item photos) — small, tracked.
!images/flags/
!images/flags/**
node_modules/
.env

# SQLite database — the Shield's copy is canonical; refresh a local copy from it
# when needed, or rebuild from firearms.json. Binary, changes on every edit.
data/firearms.db
data/firearms.db-journal
data/firearms.db-wal
data/firearms.db-shm

# Per-device Sync snapshots (js/sync.js) — keep the folder, ignore the dumps
archive/database/*.json
!archive/database/.gitkeep
